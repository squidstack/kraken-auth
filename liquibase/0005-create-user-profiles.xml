<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
    http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.4.xsd">

  <changeSet id="0005-create-user-profiles" author="squidstack">
    <createTable tableName="user_profiles" schemaName="public">
      <column name="user_id" type="uuid">
        <constraints primaryKey="true" primaryKeyName="pk_user_profiles" nullable="false"/>
      </column>
      <column name="full_name" type="text"/>
      <column name="email" type="text"/>
      <column name="phone_number" type="text"/>
      <column name="address" type="text"/>
      <column name="country_code" type="varchar(2)"/>
      <column name="roles" type="text[]"/>
    </createTable>

    <addForeignKeyConstraint
        baseTableSchemaName="public" baseTableName="user_profiles" baseColumnNames="user_id"
        referencedTableSchemaName="auth" referencedTableName="users" referencedColumnNames="id"
        constraintName="fk_user_profiles_user"/>

    <createIndex tableName="user_profiles" schemaName="public" indexName="idx_user_profiles_email">
      <column name="email"/>
    </createIndex>
    <createIndex tableName="user_profiles" schemaName="public" indexName="idx_user_profiles_country">
      <column name="country_code"/>
    </createIndex>
  </changeSet>

</databaseChangeLog>
