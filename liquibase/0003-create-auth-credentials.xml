<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
    http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.4.xsd">

  <changeSet id="0003-create-auth-credentials" author="squidstack">
    <createTable tableName="auth_credentials" schemaName="auth">
      <column name="id" type="uuid">
        <constraints primaryKey="true" primaryKeyName="pk_auth_credentials" nullable="false"/>
      </column>
      <column name="user_id" type="uuid">
        <constraints nullable="false"/>
      </column>
      <column name="password_hash" type="varchar(255)"/>
      <column name="password_algo" type="varchar(64)"/>
      <column name="password_params" type="jsonb"/>
      <column name="created_at" type="timestamptz"/>
      <column name="updated_at" type="timestamptz"/>
    </createTable>

    <addForeignKeyConstraint
        baseTableSchemaName="auth" baseTableName="auth_credentials" baseColumnNames="user_id"
        referencedTableSchemaName="auth" referencedTableName="users" referencedColumnNames="id"
        constraintName="fk_auth_credentials_user"/>

    <createIndex tableName="auth_credentials" schemaName="auth" indexName="idx_auth_credentials_user">
      <column name="user_id"/>
    </createIndex>
  </changeSet>

</databaseChangeLog>
