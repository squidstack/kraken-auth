<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
    http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.4.xsd">

  <changeSet id="0002-create-users" author="squidstack">
    <createTable tableName="users" schemaName="auth">
      <column name="id" type="uuid">
        <constraints primaryKey="true" primaryKeyName="pk_auth_users" nullable="false"/>
      </column>
      <column name="username" type="varchar(255)">
        <constraints nullable="false" unique="true" uniqueConstraintName="uq_auth_users_username"/>
      </column>
      <column name="created_at" type="timestamptz"/>
      <column name="updated_at" type="timestamptz"/>
    </createTable>
  </changeSet>

</databaseChangeLog>
