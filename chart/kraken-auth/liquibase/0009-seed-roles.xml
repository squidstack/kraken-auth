<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
    http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.4.xsd">

  <changeSet id="0009-seed-roles" author="squidstack">
    <insert tableName="roles" schemaName="auth">
      <column name="id" valueNumeric="1"/>
      <column name="name" value="admin"/>
      <column name="created_at" valueComputed="now()"/>
      <column name="updated_at" valueComputed="now()"/>
    </insert>
    <insert tableName="roles" schemaName="auth">
      <column name="id" valueNumeric="2"/>
      <column name="name" value="user"/>
      <column name="created_at" valueComputed="now()"/>
      <column name="updated_at" valueComputed="now()"/>
    </insert>
    <insert tableName="roles" schemaName="auth">
      <column name="id" valueNumeric="3"/>
      <column name="name" value="storeadmin"/>
      <column name="created_at" valueComputed="now()"/>
      <column name="updated_at" valueComputed="now()"/>
    </insert>
  </changeSet>

  <!-- Keep the sequence in sync because we inserted fixed ids 1..3 -->
  <changeSet id="0009b-fix-roles-seq" author="squidstack">
    <sql>SELECT setval('auth.roles_id_seq', (SELECT COALESCE(MAX(id), 1) FROM auth.roles));</sql>
  </changeSet>

</databaseChangeLog>
